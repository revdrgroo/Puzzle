            "tsconfig": "tsconfig.json",
            "option": "watch",
            "problemMatcher": [
                "$tsc-watch"
            ],
            "group": "build",
            "label": "tsc: watch - tsconfig.json",
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}